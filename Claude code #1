<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Stylez Inc | Mobile Car Wash</title>
<style>
:root{box-sizing:border-box;--bg:#000;--fg:#fff;--mute:#a8a8a8;--line:#2a2a2a;--card:#0e0e0e;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
html{scroll-padding-top:70px;scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:#000;color:#fff;font-family:"Helvetica Neue",Arial,sans-serif;line-height:1.55}
img{max-width:100%;display:block}
a{color:inherit}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;justify-content:space-between;align-items:center;padding:10px 18px;background:#000;border-bottom:1px solid var(--line)}
nav img{height:38px;width:auto}
nav div a{margin-left:16px;text-decoration:none;font-size:13px;letter-spacing:.12em;text-transform:uppercase}
.btn{display:inline-block;background:#fff;color:#000;padding:14px 26px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:13px;text-decoration:none;border:2px solid #fff;cursor:pointer}
.btn.o{background:transparent;color:#fff}
section{padding:60px 20px;max-width:980px;margin:0 auto}
h1{font-size:clamp(38px,9vw,76px);line-height:1;margin:0 0 16px;letter-spacing:-.02em;text-transform:uppercase}
h2{font-size:clamp(26px,6vw,40px);text-transform:uppercase;letter-spacing:-.01em;margin:0 0 8px}
.tag{font-size:12px;letter-spacing:.25em;text-transform:uppercase;color:var(--mute);margin-bottom:14px}
.hero{position:relative;min-height:82vh;display:flex;align-items:flex-end;max-width:none;padding:0}
.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) brightness(.45)}
.hero .in{position:relative;padding:60px 20px;max-width:980px;margin:0 auto;width:100%}
.hero p{max-width:480px;color:#ddd;font-size:17px}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:26px}
.card{border:1px solid var(--line);background:var(--card);padding:26px}
.card .p{font-size:44px;font-weight:800}
.card ul{padding-left:18px;color:#ccc;margin:10px 0 0}
.steps .n{font-size:34px;font-weight:800;color:#fff}
.steps .card{background:#000}
.gal{display:grid;gap:10px;grid-template-columns:repeat(2,1fr);margin-top:24px}
.gal img{width:100%;height:100%;aspect-ratio:3/4;object-fit:cover;filter:grayscale(1)}
.band{background:#fff;color:#000;max-width:none}
.band .wrap{max-width:980px;margin:0 auto}
.band .tag{color:#555}
.band .card{background:#fff;border:2px solid #000}
.band .card ul{color:#222}
.band .btn{background:#000;color:#fff;border-color:#000}
form{display:grid;gap:12px;margin-top:22px}
input,select,textarea{width:100%;background:#000;color:#fff;border:1px solid #555;padding:14px;font:inherit;border-radius:0}
label{font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--mute)}
footer{border-top:1px solid var(--line);padding:34px 20px;text-align:center;color:var(--mute);font-size:13px}
footer img{height:56px;margin:0 auto 12px}
.wa{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:6;box-shadow:0 0 0 2px #000}
@media(min-width:700px){.gal{grid-template-columns:repeat(4,1fr)}}
</style></head><body>
<nav><img src="data:image/jpeg;base64," alt="Stylez Inc"><div><a href="#services">Services</a><a href="#book">Book</a><a href="#jobs">Jobs</a></div></nav>

